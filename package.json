{
  "name": "@zenvairo/chatgpt-imagegen-mcp",
  "version": "0.1.0",
  "description": "Remote Streamable HTTP MCP server that generates images through the chatgpt.com web UI driven by Playwright",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx src/login.ts",
    "login:prod": "node dist/login.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "MEDIA_DIR=${TMPDIR:-/tmp}/chatgpt-imagegen-mcp-tests-$$ node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "playwright": "1.63.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}
