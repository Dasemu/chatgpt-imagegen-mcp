[Unit]
Description=ChatGPT image generation MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/chatgpt-imagegen-mcp
EnvironmentFile=/opt/chatgpt-imagegen-mcp/.env
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1440x900x24" /usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Hardening that keeps Chromium and the sudo-based update restart working.
# Do not set NoNewPrivileges=true: it breaks `sudo systemctl restart` in scripts/update.sh.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/chatgpt-imagegen-mcp

[Install]
WantedBy=multi-user.target
